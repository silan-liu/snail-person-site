---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/PostRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = Array.from(new Set(posts.flatMap((post) => post.data.tags)));

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const sortedYears = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="博客"
  description="记录全栈开发、系统架构、前端设计与个人工程实践的技术文章与思考笔记。"
>
  <section class="animate-fade-up">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-accent">Writing</p>
        <h1 class="mt-1.5 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          文章与笔记
        </h1>
      </div>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-ink-secondary transition-colors hover:border-line-strong hover:text-ink"
      >
        <span>RSS 订阅</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary">
      共 {posts.length} 篇文章，涵盖全栈工程实践、架构权衡与日常开发思考。
    </p>

    <!-- Tag Filter -->
    {
      allTags.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-2" role="group" aria-label="按标签筛选文章">
          <button
            type="button"
            data-blog-tag="all"
            aria-pressed="true"
            class="blog-filter-btn cursor-pointer rounded-full border border-ink bg-ink px-3.5 py-1 text-xs font-medium text-canvas transition-colors"
          >
            全部 ({posts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-blog-tag={tag}
              aria-pressed="false"
              class="blog-filter-btn cursor-pointer rounded-full border border-line bg-surface px-3.5 py-1 text-xs font-medium text-ink-secondary transition-colors hover:border-line-strong hover:text-ink"
            >
              #{tag}
            </button>
          ))}
        </div>
      )
    }

    <!-- Grouped by Year -->
    <div class="mt-10 space-y-12">
      {
        sortedYears.map((year) => (
          <div data-year-group>
            <h2 class="mb-3 border-b border-line pb-2 font-mono text-sm font-medium text-ink-muted">
              {year}
            </h2>
            <div class="divide-y divide-line/60">
              {postsByYear[year].map((post) => (
                <PostRow post={post} showTags />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('[data-post-row]');
  const yearGroups = document.querySelectorAll<HTMLElement>('[data-year-group]');

  const activeClasses = ['border-ink', 'bg-ink', 'text-canvas'];
  const inactiveClasses = ['border-line', 'bg-surface', 'text-ink-secondary', 'hover:border-line-strong', 'hover:text-ink'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.blogTag || 'all';

      buttons.forEach((item) => {
        const isCurrent = item === btn;
        item.setAttribute('aria-pressed', String(isCurrent));
        item.classList.remove(...(isCurrent ? inactiveClasses : activeClasses));
        item.classList.add(...(isCurrent ? activeClasses : inactiveClasses));
      });

      rows.forEach((row) => {
        const tags = (row.dataset.tags || '').split(',');
        const visible = selected === 'all' || tags.includes(selected);
        row.classList.toggle('hidden', !visible);
      });

      yearGroups.forEach((group) => {
        const hasVisible = group.querySelector('[data-post-row]:not(.hidden)') !== null;
        group.classList.toggle('hidden', !hasVisible);
      });
    });
  });

  // Batch load live views & likes from Cloudflare D1 API
  const slugs = Array.from(rows)
    .map((row) => row.dataset.slug)
    .filter((s): s is string => Boolean(s));

  if (slugs.length > 0) {
    fetch(`/api/posts/stats?slugs=${encodeURIComponent(slugs.join(','))}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { stats?: Record<string, { views: number; likes: number }> } | null) => {
        if (!data?.stats) return;
        for (const [slug, stat] of Object.entries(data.stats)) {
          const el = document.querySelector<HTMLElement>(`[data-row-stats="${slug}"]`);
          if (!el) continue;
          const parts = [`${stat.views} 阅读`];
          if (stat.likes > 0) parts.push(`${stat.likes} 赞`);
          el.textContent = `· ${parts.join(' · ')}`;
          el.classList.remove('hidden');
        }
      })
      .catch(() => {
        // Ignore in static-only local preview
      });
  }
</script>
