---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostEngagement from '@/components/PostEngagement.astro';
import { estimateReadingMinutes, formatDateLong } from '@/utils/format';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = estimateReadingMinutes(post.body);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="animate-fade-up mx-auto max-w-3xl">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-ink"
    >
      <span aria-hidden="true">←</span>
      <span>返回文章列表</span>
    </a>

    <!-- Post Header -->
    <header class="mt-6 border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-muted">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDateLong(post.data.pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>预计阅读 {readingMinutes} 分钟</span>
        <span data-post-views class="hidden items-center gap-2">
          <span aria-hidden="true">·</span>
          <span><span data-post-views-count>0</span> 次阅读</span>
        </span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新于 {formatDateLong(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>

      <h1 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl sm:leading-tight">
        {post.data.title}
      </h1>

      <p class="mt-4 text-base leading-relaxed text-ink-secondary">
        {post.data.description}
      </p>

      {
        post.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-md bg-surface-subtle px-2.5 py-0.5 text-xs text-ink-secondary">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Table of Contents -->
    {
      tocHeadings.length >= 2 && (
        <details class="mt-8 rounded-xl border border-line bg-surface px-5 py-4" open>
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-ink-muted">
            文章目录
          </summary>
          <ul class="mt-3 space-y-1.5 text-sm">
            {tocHeadings.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a
                  href={`#${heading.slug}`}
                  class="text-ink-secondary transition-colors hover:text-accent"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <!-- Markdown Body -->
    <div class="prose prose-editorial mt-10 max-w-none">
      <Content />
    </div>

    <!-- Views & Likes Engagement -->
    <PostEngagement slug={post.id} />

    <!-- Prev / Next Navigation -->
    {
      (prevPost || nextPost) && (
        <nav
          aria-label="上下篇导航"
          class="mt-14 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
        >
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}`}
              class="group rounded-xl border border-line bg-surface p-4 transition-colors hover:border-line-strong"
            >
              <span class="block text-xs text-ink-muted">← 上一篇</span>
              <span class="mt-1 block text-sm font-medium text-ink transition-colors group-hover:text-accent">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.id}`}
              class="group rounded-xl border border-line bg-surface p-4 text-left transition-colors hover:border-line-strong sm:text-right"
            >
              <span class="block text-xs text-ink-muted">下一篇 →</span>
              <span class="mt-1 block text-sm font-medium text-ink transition-colors group-hover:text-accent">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
