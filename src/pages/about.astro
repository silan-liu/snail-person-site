---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout title="关于" description={`了解${siteConfig.name}的背景、技术栈、工作经历与联系方式。`}>
  <section class="animate-fade-up space-y-16">
    <!-- Bio -->
    <div>
      <p class="font-mono text-xs uppercase tracking-wider text-accent">About</p>
      <h1 class="mt-1.5 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        关于{siteConfig.name}
      </h1>

      <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-ink-secondary">
        {siteConfig.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <!-- Principles -->
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          siteConfig.principles.map((item, idx) => (
            <div class="rounded-2xl border border-line bg-surface p-5">
              <span class="font-mono text-xs text-accent">0{idx + 1}</span>
              <h2 class="mt-2 text-base font-semibold text-ink">{item.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Experience Timeline -->
    <div class="border-t border-line pt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Experience</p>
      <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink">经历时间线</h2>

      <ol class="mt-8 space-y-8 border-l border-line pl-6">
        {
          siteConfig.experiences.map((exp) => (
            <li class="relative">
              <span
                class="absolute -left-[29px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-accent bg-canvas"
                aria-hidden="true"
              />
              <p class="font-mono text-xs text-ink-muted">{exp.period}</p>
              <h3 class="mt-1 text-base font-semibold text-ink">
                {exp.role}
                <span class="font-normal text-ink-secondary"> · {exp.org}</span>
              </h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-secondary">
                {exp.summary}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Skills -->
    <div class="border-t border-line pt-12">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Skills</p>
      <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink">常用技术栈</h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          siteConfig.skills.map((group) => (
            <div class="rounded-2xl border border-line bg-surface p-6">
              <h3 class="text-sm font-semibold text-ink">{group.category}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <li class="rounded-lg bg-surface-subtle px-3 py-1 text-xs font-medium text-ink-secondary">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Contact -->
    <div class="border-t border-line pt-12">
      <div class="rounded-2xl border border-line bg-surface p-7 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-wider text-accent">Contact</p>
        <h2 class="mt-1.5 text-xl font-semibold tracking-tight text-ink">保持联系</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-secondary">
          如果你有项目合作想法、技术交流话题，或者想打个招呼，邮件是最直接的方式：
          <a
            href={`mailto:${siteConfig.email}`}
            class="font-mono text-ink underline decoration-line-strong underline-offset-4 hover:text-accent"
          >
            {siteConfig.email}
          </a>
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/guestbook"
            class="inline-flex items-center gap-2 rounded-xl bg-ink px-4 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
          >
            <span>去留言板留言</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-subtle"
          >
            <span>写邮件给我</span>
            <span aria-hidden="true">↗</span>
          </a>
          <CopyEmailButton />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
