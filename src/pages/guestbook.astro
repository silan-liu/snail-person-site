---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="留言板"
  description={`给${siteConfig.name}留言、交流技术或探讨合作，也支持直接发送邮件联系。`}
>
  <section class="animate-fade-up space-y-12">
    <!-- Header -->
    <div>
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Guestbook & Contact</p>
      <h1 class="mt-1.5 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        留言板与联系
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary">
        欢迎留下你的脚印、对文章的反馈或合作想法。如需私密沟通，也可以直接发邮件至
        <a
          href={`mailto:${siteConfig.email}`}
          class="font-mono text-ink underline decoration-line-strong underline-offset-4 hover:text-accent"
        >
          {siteConfig.email}
        </a>
        。
      </p>
    </div>

    <!-- Submission Form -->
    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold tracking-tight text-ink">写一条留言</h2>
        <CopyEmailButton />
      </div>

      <form id="guestbook-form" class="space-y-4" novalidate>
        <!-- Honeypot anti-spam field -->
        <div class="hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="nickname" class="mb-1.5 block text-xs font-medium text-ink">
              昵称 <span class="text-accent">*</span>
            </label>
            <input
              id="nickname"
              name="nickname"
              type="text"
              required
              maxlength="30"
              placeholder="怎么称呼你"
              class="w-full rounded-xl border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-xs font-medium text-ink">
              邮箱 <span class="font-normal text-ink-muted">（选填，仅作者可见，不公开显示）</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              maxlength="100"
              placeholder="方便我回复你"
              class="w-full rounded-xl border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="website" class="mb-1.5 block text-xs font-medium text-ink">
            个人主页 / GitHub <span class="font-normal text-ink-muted">（选填）</span>
          </label>
          <input
            id="website"
            name="website"
            type="url"
            maxlength="200"
            placeholder="https://..."
            class="w-full rounded-xl border border-line bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <div class="mb-1.5 flex items-center justify-between">
            <label for="content" class="block text-xs font-medium text-ink">
              留言内容 <span class="text-accent">*</span>
            </label>
            <span id="char-count" class="font-mono text-xs text-ink-muted">0 / 500</span>
          </div>
          <textarea
            id="content"
            name="content"
            rows="4"
            required
            maxlength="500"
            placeholder="想聊的技术、文章反馈、产品想法，或者简单打个招呼……"
            class="w-full resize-y rounded-xl border border-line bg-canvas px-3.5 py-2.5 text-sm leading-relaxed text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
          <p id="form-feedback" class="text-xs text-ink-muted" role="status" aria-live="polite"></p>
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span>发布留言</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Guestbook Wall -->
    <div class="border-t border-line pt-10">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold tracking-tight text-ink">最近留言</h2>
        <span id="message-total" class="font-mono text-xs text-ink-muted">加载中...</span>
      </div>

      <div id="guestbook-list" class="space-y-4">
        <div class="rounded-2xl border border-line bg-surface p-6 text-sm text-ink-muted">
          正在加载留言列表...
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface GuestbookMessage {
    id: number;
    nickname: string;
    website: string | null;
    content: string;
    created_at: string;
  }

  const form = document.getElementById('guestbook-form') as HTMLFormElement | null;
  const contentInput = document.getElementById('content') as HTMLTextAreaElement | null;
  const charCountEl = document.getElementById('char-count');
  const feedbackEl = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const listEl = document.getElementById('guestbook-list');
  const totalEl = document.getElementById('message-total');

  let messageCount = 0;

  function formatTimestamp(raw: string): string {
    const normalized = raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`;
    const date = new Date(normalized);
    if (Number.isNaN(date.valueOf())) return raw;
    return date.toLocaleString('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
  }

  function createMessageCard(msg: GuestbookMessage): HTMLElement {
    const card = document.createElement('article');
    card.className = 'rounded-2xl border border-line bg-surface p-5 sm:p-6';

    const header = document.createElement('div');
    header.className = 'flex items-center justify-between gap-3';

    const authorWrap = document.createElement('div');
    authorWrap.className = 'flex items-center gap-2.5 min-w-0';

    const avatar = document.createElement('span');
    avatar.className =
      'inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-surface-subtle text-xs font-semibold text-ink';
    avatar.textContent = Array.from(msg.nickname.trim())[0] || '访';

    authorWrap.appendChild(avatar);

    if (msg.website) {
      const link = document.createElement('a');
      link.href = msg.website;
      link.target = '_blank';
      link.rel = 'noopener noreferrer nofollow';
      link.className =
        'truncate text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:text-accent';
      link.textContent = msg.nickname;
      authorWrap.appendChild(link);
    } else {
      const nameSpan = document.createElement('span');
      nameSpan.className = 'truncate text-sm font-medium text-ink';
      nameSpan.textContent = msg.nickname;
      authorWrap.appendChild(nameSpan);
    }

    const time = document.createElement('time');
    time.className = 'shrink-0 font-mono text-xs text-ink-muted';
    time.textContent = formatTimestamp(msg.created_at);

    header.appendChild(authorWrap);
    header.appendChild(time);

    const body = document.createElement('p');
    body.className = 'mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-secondary';
    body.textContent = msg.content;

    card.appendChild(header);
    card.appendChild(body);
    return card;
  }

  function updateTotalLabel() {
    if (totalEl) totalEl.textContent = `共 ${messageCount} 条`;
  }

  function renderEmptyState(text: string) {
    if (!listEl) return;
    listEl.replaceChildren();
    const box = document.createElement('div');
    box.className = 'rounded-2xl border border-dashed border-line bg-surface/60 p-8 text-center text-sm text-ink-muted';
    box.textContent = text;
    listEl.appendChild(box);
  }

  async function loadMessages() {
    if (!listEl) return;
    try {
      const res = await fetch('/api/guestbook');
      if (!res.ok) throw new Error('Failed to load');
      const data = (await res.json()) as { messages?: GuestbookMessage[] };
      const messages = data.messages ?? [];
      messageCount = messages.length;
      updateTotalLabel();

      if (messages.length === 0) {
        renderEmptyState('还没有留言，来写下第一条吧。');
        return;
      }

      listEl.replaceChildren(...messages.map(createMessageCard));
    } catch {
      if (totalEl) totalEl.textContent = '';
      renderEmptyState('当前环境未连接留言后端服务（部署到 Cloudflare Workers 后自动可用）。');
    }
  }

  contentInput?.addEventListener('input', () => {
    if (charCountEl) {
      charCountEl.textContent = `${contentInput.value.length} / 500`;
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn || !feedbackEl) return;

    const formData = new FormData(form);
    const payload = {
      nickname: String(formData.get('nickname') || '').trim(),
      email: String(formData.get('email') || '').trim(),
      website: String(formData.get('website') || '').trim(),
      content: String(formData.get('content') || '').trim(),
      company: String(formData.get('company') || '').trim(),
    };

    if (!payload.nickname) {
      feedbackEl.textContent = '请先填写昵称。';
      feedbackEl.className = 'text-xs text-amber-600 dark:text-amber-400';
      return;
    }
    if (payload.content.length < 2) {
      feedbackEl.textContent = '留言内容至少输入 2 个字。';
      feedbackEl.className = 'text-xs text-amber-600 dark:text-amber-400';
      return;
    }

    submitBtn.disabled = true;
    feedbackEl.textContent = '正在提交...';
    feedbackEl.className = 'text-xs text-ink-muted';

    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string; message?: GuestbookMessage | null };

      if (!res.ok) {
        feedbackEl.textContent = data.error || '提交失败，请稍后重试。';
        feedbackEl.className = 'text-xs text-rose-600 dark:text-rose-400';
        return;
      }

      form.reset();
      if (charCountEl) charCountEl.textContent = '0 / 500';
      feedbackEl.textContent = '留言已发布，感谢你的来访！';
      feedbackEl.className = 'text-xs text-accent';

      if (data.message && listEl) {
        if (messageCount === 0) {
          listEl.replaceChildren(createMessageCard(data.message));
        } else {
          listEl.prepend(createMessageCard(data.message));
        }
        messageCount += 1;
        updateTotalLabel();
      }
    } catch {
      feedbackEl.textContent = '网络请求失败，请稍后重试。';
      feedbackEl.className = 'text-xs text-rose-600 dark:text-rose-400';
    } finally {
      submitBtn.disabled = false;
    }
  });

  loadMessages();
</script>
